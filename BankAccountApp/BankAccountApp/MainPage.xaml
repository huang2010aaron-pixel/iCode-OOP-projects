<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BankAccountApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="15">
            <Image
                Aspect="AspectFit"
                HeightRequest="200"
                SemanticProperties.Description="bank icon"
                Source="bank.png" />

            <Entry x:Name="Textbox" WidthRequest="100" />
            
            <Button
                x:Name="DepositButton"
                Clicked="DepositButton_Clicked"
                HorizontalOptions="Fill"
                Text="Deposit"
                WidthRequest="100" 
                BackgroundColor="DodgerBlue"/>

            <Button
                x:Name="WithdrawButton"
                Clicked="WithdrawButton_Clicked"
                HorizontalOptions="Fill"
                Text="Withdraw"
                WidthRequest="100"
                BackgroundColor="DodgerBlue"/>

            <Label
                
                x:Name="Counter"
                FontSize="40"
                HorizontalOptions="Center"
                Text="$ 0"/>

            <Label
                x:Name="FormatWarning"
                FontSize="20"
                HorizontalOptions="Center"
                Text=""/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
