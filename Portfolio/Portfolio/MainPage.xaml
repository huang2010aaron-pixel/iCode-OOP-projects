<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Portfolio.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout
            x:Name="Background"
            Padding="30,0"
            BackgroundColor="Aqua"
            Spacing="25">

            <Label
                x:Name="Title"
                FontSize="40"
                HorizontalOptions="Center"
                Text="Welcome to my portfolio!"
                TextColor="Black" />
            <Label
                x:Name="Description"
                FontSize="25"
                HorizontalOptions="Start"
                Text="My name is Aaron, and I am 15. I like to play volleyball, I'm part of my school's math team, and I like playing video games."
                TextColor="Black" />
            <Button
                x:Name="ColorButton"
                BackgroundColor="BlueViolet"
                Clicked="ColorButton_Clicked"
                FontSize="20"
                Text="Click me!"
                TextColor="Black"
                WidthRequest="120" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
