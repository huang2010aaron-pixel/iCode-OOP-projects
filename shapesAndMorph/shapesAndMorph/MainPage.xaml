<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="shapesAndMorph.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" SizeChanged="Layout_SizeChanged">
            <Label x:Name="Title"
                   Text="Polymorphism Demo"
                   FontSize="24"
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10" Padding="10">
                <Entry x:Name="value1" WidthRequest="100" FontSize="24" Placeholder="Value 1"/>
                <Entry x:Name="value2" WidthRequest="100" FontSize="24" Placeholder="Value 2"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10" Padding="10">
                <Button x:Name="CircleButton" Clicked="CircleButton_Clicked" FontSize="24" Text="Circle" WidthRequest="100"/>
                <Button x:Name="SquareButton" Clicked="SquareButton_Clicked" FontSize="24" Text="Square" WidthRequest="120"/>
                <Button x:Name="RectangleButton" Clicked="RectangleButton_Clicked" FontSize="24" Text="Rectangle" WidthRequest="150"/>
                <Button x:Name="TriangleButton" Clicked="TriangleButton_Clicked" FontSize="24" Text="Triangle" WidthRequest="130"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10" Padding="10">
                <Button x:Name="AreaButton" Clicked="CalculateArea" FontSize="24" Text="Area" WidthRequest="100"/>
                <Button x:Name="PerimeterButton" Clicked="CalculatePerimeter" FontSize="24" Text="Perimeter" WidthRequest="150"/>
            </HorizontalStackLayout>
            <Label
                x:Name="Result"
                FontSize="0"
                Text=""
                />
            <CollectionView x:Name="ShapesListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                    <HorizontalStackLayout Spacing="10" Padding="10">
                        <Label Text="{Binding Name}" FontAttributes="Bold" WidthRequest="100" />
                        <Label Text="Area: " />
                        <Label Text="{Binding ResultArea}" TextColor="Blue" />
                        <Label Text="Perimeter: " />
                        <Label Text="{Binding ResultPerimeter}" TextColor="Orange" />
                    </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
